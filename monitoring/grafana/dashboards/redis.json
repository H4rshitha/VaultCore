{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Redis Cache Hit Ratio (%)",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(vaultcore_redis_cache_hits_total[1m])) / (sum(rate(vaultcore_redis_cache_hits_total[1m])) + sum(rate(vaultcore_redis_cache_misses_total[1m]))) * 100",
          "legendFormat": "Hit Ratio (%)"
        }
      ]
    },
    {
      "title": "Cache Hits vs Misses Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "sum by (service) (rate(vaultcore_redis_cache_hits_total[1m]))",
          "legendFormat": "Hits - {{service}}"
        },
        {
          "expr": "sum by (service) (rate(vaultcore_redis_cache_misses_total[1m]))",
          "legendFormat": "Misses - {{service}}"
        }
      ]
    },
    {
      "title": "Redis Write Latency (P95, P99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(vaultcore_redis_write_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "P95 Latency"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(vaultcore_redis_write_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "P99 Latency"
        }
      ]
    },
    {
      "title": "Multi-DB Operation Breakdown (DB0: Rate, DB1: Cache, DB2: Locks, DB3: Sessions)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(vaultcore_rate_limit_allowed_total[1m])) + sum(rate(vaultcore_rate_limit_blocked_total[1m]))",
          "legendFormat": "DB0 - Rate Limiter Operations"
        },
        {
          "expr": "sum(rate(vaultcore_redis_cache_hits_total[1m])) + sum(rate(vaultcore_redis_cache_misses_total[1m]))",
          "legendFormat": "DB1 - Account Cache Reads"
        },
        {
          "expr": "sum(rate(vaultcore_distributed_lock_acquisitions_total[1m]))",
          "legendFormat": "DB2 - Distributed Lock Operations"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["vaultcore", "redis", "caching"],
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m"] },
