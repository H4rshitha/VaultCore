  "liveNow": false,
  "panels": [
    {
      "title": "Payment Transaction Volume (TPS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (status) (rate(vaultcore_payments_processed_total[1m]))",
          "legendFormat": "Status {{status}}"
        }
      ]
    },
    {
      "title": "Payment Orchestration Latency (P50, P95, P99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(vaultcore_payment_processing_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "P50 Latency"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(vaultcore_payment_processing_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "P95 Latency"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(vaultcore_payment_processing_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "P99 Latency"
        }
      ]
    },
    {
      "title": "Cumulative Funds Transferred ($)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "sum(vaultcore_payment_amount_transferred_total)",
          "legendFormat": "Total USD Transferred"
        }
      ]
    },
    {
      "title": "Ledger Double-Entry Execution Latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(vaultcore_ledger_transaction_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "Ledger Call P95"
        }
      ]
    },
    {
      "title": "Payment Success vs Failure Ratio",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum by (status) (vaultcore_payments_processed_total)",
          "legendFormat": "{{status}}"
        }
      ]
    }
  ],
