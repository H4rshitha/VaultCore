{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Gateway Request Rate (RPS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(vaultcore_http_requests_total{service=~\"gateway.*\"}[1m]))",
          "legendFormat": "Total Requests / sec"
        }
      ]
    },
    {
      "title": "Gateway Latency (P50, P95, P99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(vaultcore_http_request_duration_seconds_bucket{service=~\"gateway.*\"}[1m])) by (le))",
          "legendFormat": "P50 Latency"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(vaultcore_http_request_duration_seconds_bucket{service=~\"gateway.*\"}[1m])) by (le))",
          "legendFormat": "P95 Latency"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(vaultcore_http_request_duration_seconds_bucket{service=~\"gateway.*\"}[1m])) by (le))",
          "legendFormat": "P99 Latency"
        }
      ]
    },
    {
      "title": "HTTP Error Rate (4xx / 5xx)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(vaultcore_http_errors_total{service=~\"gateway.*\"}[1m])) / sum(rate(vaultcore_http_requests_total{service=~\"gateway.*\"}[1m])) * 100",
          "legendFormat": "Error Rate (%)"
        }
      ]
    },
    {
      "title": "Distributed Rate Limiter (Allowed vs 429 Blocked)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum by (tier) (rate(vaultcore_rate_limit_allowed_total[1m]))",
          "legendFormat": "Allowed - Tier {{tier}}"
        },
        {
          "expr": "sum by (tier) (rate(vaultcore_rate_limit_blocked_total[1m]))",
          "legendFormat": "Blocked 429 - Tier {{tier}}"
        }
      ]
    },
    {
      "title": "Downstream Circuit Breaker Statuses",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "vaultcore_circuit_breaker_state",
          "legendFormat": "Service {{service}}"
        }
      ]
    },
    {
      "title": "Active Requests per Downstream Service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "vaultcore_http_active_requests",
          "legendFormat": "{{service}}"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["vaultcore", "gateway", "production"],
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m"] },
  "timezone": "browser",
  "title": "VaultCore — API Gateway Dashboard",
  "uid": "vaultcore-api-gateway"
}
