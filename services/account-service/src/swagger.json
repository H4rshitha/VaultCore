{
  "openapi": "3.0.0",
  "info": {
    "title": "VaultCore Account Service API",
    "version": "1.0.0",
    "description": "Production Account Microservice supporting 12-digit account creation, detail lookups, balance retrieval, and paginated account listing."
  },
  "servers": [
    {
      "url": "http://localhost:3002",
      "description": "Account Microservice Direct Port"
    },
    {
      "url": "http://localhost:3000/api/v1/accounts",
      "description": "API Gateway Proxy Route"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Account": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "accountNumber": { "type": "string", "example": "100084729103" },
          "userId": { "type": "string", "format": "uuid" },
          "type": { "type": "string", "enum": ["SAVINGS", "CHECKING", "INVESTMENT"] },
          "status": { "type": "string", "enum": ["ACTIVE", "FROZEN", "CLOSED"] },
          "balance": { "type": "number", "example": 5000.0 },
          "currency": { "type": "string", "example": "USD" },
          "version": { "type": "integer", "example": 0 },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  },
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health Check",
        "security": [],
        "responses": {
          "200": { "description": "Account Service is healthy" }
        }
      }
    },
    "/": {
      "post": {
        "summary": "Create a new bank account with auto-generated 12-digit account number",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": ["SAVINGS", "CHECKING", "INVESTMENT"],
                    "default": "CHECKING"
                  },
                  "currency": { "type": "string", "default": "USD" },
                  "initialDeposit": { "type": "number", "default": 0 }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Account created successfully" },
          "400": { "description": "Validation error" },
          "401": { "description": "Unauthorized" }
        }
      },
      "get": {
        "summary": "List all bank accounts owned by authenticated user (with pagination)",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 10 } }
        ],
        "responses": {
          "200": { "description": "List of user bank accounts with pagination metadata" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/{accountNumber}": {
      "get": {
        "summary": "Fetch bank account details by 12-digit account number",
        "parameters": [
          {
            "name": "accountNumber",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "example": "100084729103" }
          }
        ],
        "responses": {
          "200": { "description": "Account details object" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden - Account belong to another user" },
          "404": { "description": "Account not found" }
        }
      }
    },
    "/{accountNumber}/balance": {
      "get": {
        "summary": "Fetch current balance for a specific bank account",
        "parameters": [
          {
            "name": "accountNumber",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "example": "100084729103" }
          }
        ],
        "responses": {
          "200": { "description": "Current balance payload" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "Account not found" }
        }
      }
    }
  }
}
