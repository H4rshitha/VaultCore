{
  "openapi": "3.0.0",
  "info": {
    "title": "VaultCore Notification Service API",
    "version": "1.0.0",
    "description": "Asynchronous event subscriber, RabbitMQ consumer, Dead Letter Queue (DLQ) manager, and Email/SMS notification microservice for VaultCore."
  },
  "servers": [
    {
      "url": "http://localhost:3005",
      "description": "Notification Microservice Direct Port"
    },
    {
      "url": "http://localhost:3000/api/v1/notifications",
      "description": "API Gateway Proxy Route"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "NotificationAudit": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "eventId": { "type": "string", "example": "evt-20260915-001" },
          "transactionId": { "type": "string", "format": "uuid" },
          "notificationType": { "type": "string", "enum": ["EMAIL", "SMS", "PUSH"] },
          "recipient": { "type": "string", "example": "alice@example.com" },
          "status": { "type": "string", "enum": ["PENDING", "SENT", "FAILED", "DELIVERED"] },
          "retryCount": { "type": "integer", "example": 0 },
          "errorMessage": { "type": "string", "nullable": true },
          "traceId": { "type": "string", "format": "uuid" },
          "processedAt": { "type": "string", "format": "date-time" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "AdminStatusResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "HEALTHY" },
          "timestamp": { "type": "string", "format": "date-time" },
          "queueHealth": {
            "type": "object",
            "properties": {
              "emailQueue": { "type": "string", "example": "HEALTHY" },
              "smsQueue": { "type": "string", "example": "HEALTHY" },
              "dlqQueue": { "type": "string", "example": "HEALTHY" }
            }
          },
          "statistics": {
            "type": "object",
            "properties": {
              "sent": { "type": "integer", "example": 150 },
              "failed": { "type": "integer", "example": 2 },
              "pending": { "type": "integer", "example": 0 },
              "delivered": { "type": "integer", "example": 0 },
              "total": { "type": "integer", "example": 152 }
            }
          },
          "consumer": {
            "type": "object",
            "properties": {
              "isRunning": { "type": "boolean", "example": true },
              "maxRetries": { "type": "integer", "example": 3 },
              "uptimeSeconds": { "type": "integer", "example": 3600 },
              "messagesConsumed": { "type": "integer", "example": 152 },
              "successfulDeliveries": { "type": "integer", "example": 150 },
              "failedDeliveries": { "type": "integer", "example": 2 },
              "dlqCount": { "type": "integer", "example": 1 },
              "averageLatencyMs": { "type": "integer", "example": 14 }
            }
          }
        }
      }
    }
  },
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health Check",
        "security": [],
        "responses": {
          "200": { "description": "Notification Service is healthy" }
        }
      }
    },
    "/history": {
      "get": {
        "summary": "Fetch customer notification history",
        "description": "Returns paginated notification audit records for the authenticated customer.",
        "parameters": [
          { "name": "X-Trace-ID", "in": "header", "required": false, "schema": { "type": "string", "format": "uuid" } },
          { "name": "cursor", "in": "query", "schema": { "type": "string", "format": "uuid" }, "description": "Cursor pagination ID" },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 } },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["PENDING", "SENT", "FAILED", "DELIVERED"] } },
          { "name": "type", "in": "query", "schema": { "type": "string", "enum": ["EMAIL", "SMS", "PUSH"] } },
          { "name": "startDate", "in": "query", "schema": { "type": "string", "format": "date-time" } },
          { "name": "endDate", "in": "query", "schema": { "type": "string", "format": "date-time" } }
        ],
        "responses": {
          "200": { "description": "Paginated list of customer notification audit records" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/admin/status": {
      "get": {
        "summary": "Retrieve notification queue health and consumer metrics",
        "description": "Admin endpoint returning queue health, DLQ size, delivery statistics, and consumer uptime.",
        "parameters": [
          { "name": "X-Trace-ID", "in": "header", "required": false, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "Notification admin metrics and queue health retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminStatusResponse"
                }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden - Requires ADMIN role" }
        }
      }
    }
  }
}
