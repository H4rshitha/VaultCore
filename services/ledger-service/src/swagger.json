{
  "openapi": "3.0.0",
  "info": {
    "title": "VaultCore Ledger Service API",
    "version": "1.0.0",
    "description": "Double-Entry Bookkeeping Ledger Microservice. Exposes internal endpoints for trusted services (Payment Service/Gateway) and public authenticated endpoints for account history queries."
  },
  "servers": [
    {
      "url": "http://localhost:3004",
      "description": "Ledger Microservice Direct Port"
    },
    {
      "url": "http://localhost:3000/api/v1/ledger",
      "description": "API Gateway Proxy Route"
    }
  ],
  "tags": [
    {
      "name": "Internal - Ledger Operations",
      "description": "Internal microservice APIs strictly authenticated via service API key (x-service-api-key)."
    },
    {
      "name": "Public - Account Ledger History",
      "description": "Customer-facing APIs authenticated via user JWT Bearer token."
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT Bearer token for user-facing endpoints"
      },
      "serviceApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-service-api-key",
        "description": "Internal service API key for inter-service communication (e.g. from Payment Service)"
      }
    },
    "schemas": {
      "LedgerEntry": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "transactionId": { "type": "string", "format": "uuid" },
          "accountId": { "type": "string", "format": "uuid" },
          "type": { "type": "string", "enum": ["DEBIT", "CREDIT"] },
          "amount": { "type": "number", "example": 150.0 },
          "balanceAfter": { "type": "number", "example": 4850.0 },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health Check",
        "tags": ["System"],
        "responses": {
          "200": { "description": "Ledger Service is healthy" }
        }
      }
    },
    "/entries": {
      "post": {
        "tags": ["Internal - Ledger Operations"],
        "summary": "[INTERNAL] Record double-entry financial transfer",
        "description": "Internal endpoint for Payment Service and trusted internal services to atomically write DEBIT/CREDIT records and update Account balances.",
        "security": [{ "serviceApiKeyAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "idempotencyKey",
                  "sourceAccountNumber",
                  "targetAccountNumber",
                  "amount"
                ],
                "properties": {
                  "idempotencyKey": {
                    "type": "string",
                    "format": "uuid",
                    "example": "9b1deb4d-3b7d-4bad-9bdd-2b0d7b3dcb6d"
                  },
                  "referenceId": { "type": "string", "example": "REF-2026-09-001" },
                  "sourceAccountNumber": { "type": "string", "example": "100010001001" },
                  "targetAccountNumber": { "type": "string", "example": "200020002001" },
                  "amount": { "type": "number", "example": 150.0 },
                  "currency": { "type": "string", "default": "USD" },
                  "description": { "type": "string", "example": "Transfer memo" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Double-entry transfer recorded" },
          "200": { "description": "Idempotent duplicate request returned existing transaction" },
          "400": { "description": "Validation error or insufficient funds" },
          "401": { "description": "Unauthorized - Missing x-service-api-key header" },
          "403": { "description": "Forbidden - Invalid internal service API key" },
          "404": { "description": "Source or target account not found" }
        }
      }
    },
    "/accounts/{accountNumber}/entries": {
      "get": {
        "tags": ["Public - Account Ledger History"],
        "summary": "[PUBLIC] Fetch cursor-paginated ledger entries for an account",
        "description": "User-facing endpoint to inspect account audit trails and statement entries.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "accountNumber",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "example": "100010001001" }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": { "type": "string" },
            "description": "Pagination cursor ID"
          },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 } },
          {
            "name": "type",
            "in": "query",
            "schema": { "type": "string", "enum": ["DEBIT", "CREDIT"] }
          },
          { "name": "startDate", "in": "query", "schema": { "type": "string", "format": "date" } },
          { "name": "endDate", "in": "query", "schema": { "type": "string", "format": "date" } },
          { "name": "referenceId", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Account ledger history returned with nextCursor" },
          "401": { "description": "Unauthorized - Missing or invalid Bearer JWT" },
          "403": { "description": "Forbidden - Access denied to account" },
          "404": { "description": "Account not found" }
        }
      }
    }
  }
}
