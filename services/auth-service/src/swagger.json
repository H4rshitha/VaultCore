{
  "openapi": "3.0.0",
  "info": {
    "title": "VaultCore Auth Service API",
    "version": "1.0.0",
    "description": "Production Auth Microservice supporting signup, login, JWT access & refresh tokens, token revocation logout, and RBAC authorization."
  },
  "servers": [
    {
      "url": "http://localhost:3001",
      "description": "Auth Microservice Direct Port"
    },
    {
      "url": "http://localhost:3000/api/v1/auth",
      "description": "API Gateway Proxy Route"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "email": { "type": "string", "format": "email" },
          "firstName": { "type": "string" },
          "lastName": { "type": "string" },
          "role": { "type": "string", "enum": ["CUSTOMER", "ADMIN", "TELLER"] },
          "isActive": { "type": "boolean" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "AuthTokens": {
        "type": "object",
        "properties": {
          "accessToken": { "type": "string" },
          "refreshToken": { "type": "string" }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health Check",
        "responses": {
          "200": { "description": "Auth Service is operating normally" }
        }
      }
    },
    "/signup": {
      "post": {
        "summary": "Register a new VaultCore user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password", "firstName", "lastName"],
                "properties": {
                  "email": { "type": "string", "example": "john.doe@vaultcore.io" },
                  "password": { "type": "string", "example": "Password123!" },
                  "firstName": { "type": "string", "example": "John" },
                  "lastName": { "type": "string", "example": "Doe" },
                  "role": { "type": "string", "enum": ["CUSTOMER", "ADMIN"], "default": "CUSTOMER" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "User created successfully with access & refresh tokens" },
          "400": { "description": "Validation error" },
          "409": { "description": "User email already exists" }
        }
      }
    },
    "/login": {
      "post": {
        "summary": "Authenticate user and issue tokens",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "example": "john.doe@vaultcore.io" },
                  "password": { "type": "string", "example": "Password123!" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login successful" },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/refresh": {
      "post": {
        "summary": "Issue a new Access Token using a valid Refresh Token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["refreshToken"],
                "properties": {
                  "refreshToken": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "New Access Token generated" },
          "401": { "description": "Invalid, expired, or revoked Refresh Token" }
        }
      }
    },
    "/logout": {
      "post": {
        "summary": "Revoke Refresh Token and log user out",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["refreshToken"],
                "properties": {
                  "refreshToken": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Logout successful" }
        }
      }
    },
    "/me": {
      "get": {
        "summary": "Fetch authenticated user profile claims",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "User profile returned" },
          "401": { "description": "Unauthorized - Missing or invalid Bearer token" }
        }
      }
    }
  }
}
